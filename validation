WITH global_session_first_touch AS (
  SELECT
    CONCAT((SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id'), user_pseudo_id) AS unique_session_id,
    -- Pinpoint the exact page title where the session started
    MAX(CASE WHEN (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'entrances') = 1 
             THEN (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_title') 
        END) AS landing_page_title,
    -- Pull the specific traffic parameters tied only to that entrance row
    MAX(CASE WHEN (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'entrances') = 1 
             THEN LOWER(collected_traffic_source.manual_source) 
        END) AS landing_source,
    MAX(CASE WHEN (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'entrances') = 1 
             THEN LOWER(collected_traffic_source.manual_medium) 
        END) AS landing_medium
  FROM `enter.tablename_123456.events_*` -- Replace with your project and dataset ID
  GROUP BY unique_session_id
),

session_conversions AS (
  SELECT
    CONCAT((SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id'), user_pseudo_id) AS unique_session_id,
    COUNT(CASE WHEN event_name = 'purchase' THEN 1 END) AS session_purchases,
    SUM(CASE WHEN event_name = 'purchase' THEN COALESCE(event_value_in_usd, 0) END) AS session_revenue
  FROM `enter.tablename_123456.events_*` -- Replace with your project and dataset ID
  GROUP BY unique_session_id
)

SELECT
  g.unique_session_id,
  g.landing_page_title,
  COALESCE(g.landing_source, 'direct') AS source,
  COALESCE(g.landing_medium, 'none') AS medium,
  
  -- Validation flag to easily see how the row will categorize itself
  CASE 
    WHEN g.landing_page_title = 'Home - Homepage' AND g.landing_source = 'google' AND g.landing_medium = 'organic' 
      THEN 'Homepage: Google Organic'
    WHEN g.landing_page_title = 'Home - Homepage' AND g.landing_source IN ('bing','yahoo','duckduckgo') AND g.landing_medium = 'organic' 
      THEN 'Homepage: Other Organic'
    WHEN g.landing_page_title = 'Home - Homepage' 
      THEN 'Homepage: Non-Organic Entry'
    WHEN g.landing_page_title = 'Enter Login Page_Title' AND g.landing_source = 'google' AND g.landing_medium = 'organic' 
      THEN 'Login: Google Organic'
    ELSE 'Other Site Journey'
  END AS validation_bucket,
  
  COALESCE(c.session_purchases, 0) AS purchases,
  COALESCE(c.session_revenue, 0) AS revenue

FROM global_session_first_touch g
LEFT JOIN session_conversions c ON g.unique_session_id = c.unique_session_id;
