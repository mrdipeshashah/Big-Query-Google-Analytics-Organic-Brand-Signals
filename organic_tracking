WITH global_session_first_touch AS (
  SELECT
    CONCAT((SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id'), user_pseudo_id) AS unique_session_id,
    PARSE_DATE('%Y%m%d', event_date) AS session_start_date,
    MAX(CASE WHEN (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'entrances') = 1 
             THEN (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_title') 
        END) AS landing_page_title,
    MAX(CASE WHEN (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'entrances') = 1 
             THEN LOWER(collected_traffic_source.manual_source) 
        END) AS landing_source,
    MAX(CASE WHEN (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'entrances') = 1 
             THEN LOWER(collected_traffic_source.manual_medium) 
        END) AS landing_medium
  FROM `mrdipeshashah.analytics_343520795.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20250101' AND '20261231'
  GROUP BY unique_session_id, event_date
),

session_attribution AS (
  SELECT 
    unique_session_id,
    MIN(session_start_date) AS date,
    MAX(landing_page_title) AS landing_page_title,
    COALESCE(MAX(landing_source), 'direct') AS source,
    COALESCE(MAX(landing_medium), 'none') AS medium
  FROM global_session_first_touch
  GROUP BY unique_session_id
),

session_conversions AS (
  SELECT
    CONCAT((SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id'), user_pseudo_id) AS unique_session_id,
    COUNT(CASE WHEN event_name = 'purchase' THEN 1 END) AS session_purchases,
    SUM(CASE WHEN event_name = 'purchase' THEN COALESCE(event_value_in_usd, 0) END) AS session_revenue
  FROM `mrdipeshashah.analytics_343520795.events_*`
  WHERE _TABLE_SUFFIX BETWEEN '20250101' AND '20261231'
  GROUP BY unique_session_id
)

SELECT
  -- CORE DATE DIMENSIONS
  sb.date,
  EXTRACT(YEAR FROM sb.date) AS year,
  -- Continuous Chronological Month Index (Jan 2025 = 1, Dec 2025 = 12, Jan 2026 = 13...)
  ((EXTRACT(YEAR FROM sb.date) - 2025) * 12) + EXTRACT(MONTH FROM sb.date) AS month_number,
  FORMAT_DATE('%b-%Y', sb.date) AS month_year, -- Formats as 'Jan-2025'
  EXTRACT(WEEK FROM sb.date) AS week_number,
  DATE_TRUNC(sb.date, WEEK(MONDAY)) AS week_starting_monday,
  
  -- MACRO SITE TOTALS
  COUNT(DISTINCT sb.unique_session_id) AS total_site_sessions,
  SUM(COALESCE(sc.session_purchases, 0)) AS total_site_purchases,
  SUM(COALESCE(sc.session_revenue, 0)) AS total_site_revenue,

  -------------------------------------------------------------------------
  -- HOMEPAGE DETAILED SEGMENTS
  -------------------------------------------------------------------------
  -- Google Organic
  COUNT(DISTINCT CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'google' AND sb.medium = 'organic' THEN sb.unique_session_id END) AS homepage_organic_google_sessions,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'google' AND sb.medium = 'organic' THEN COALESCE(sc.session_purchases, 0) ELSE 0 END) AS homepage_organic_google_purchases,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'google' AND sb.medium = 'organic' THEN COALESCE(sc.session_revenue, 0) ELSE 0 END) AS homepage_organic_google_revenue,

  -- Bing Organic
  COUNT(DISTINCT CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'bing' AND sb.medium = 'organic' THEN sb.unique_session_id END) AS homepage_organic_bing_sessions,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'bing' AND sb.medium = 'organic' THEN COALESCE(sc.session_purchases, 0) ELSE 0 END) AS homepage_organic_bing_purchases,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'bing' AND sb.medium = 'organic' THEN COALESCE(sc.session_revenue, 0) ELSE 0 END) AS homepage_organic_bing_revenue,

  -- Yahoo Organic
  COUNT(DISTINCT CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'yahoo' AND sb.medium = 'organic' THEN sb.unique_session_id END) AS homepage_organic_yahoo_sessions,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'yahoo' AND sb.medium = 'organic' THEN COALESCE(sc.session_purchases, 0) ELSE 0 END) AS homepage_organic_yahoo_purchases,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'yahoo' AND sb.medium = 'organic' THEN COALESCE(sc.session_revenue, 0) ELSE 0 END) AS homepage_organic_yahoo_revenue,

  -- DuckDuckGo Organic
  COUNT(DISTINCT CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'duckduckgo' AND sb.medium = 'organic' THEN sb.unique_session_id END) AS homepage_organic_duckduckgo_sessions,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'duckduckgo' AND sb.medium = 'organic' THEN COALESCE(sc.session_purchases, 0) ELSE 0 END) AS homepage_organic_duckduckgo_purchases,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source = 'duckduckgo' AND sb.medium = 'organic' THEN COALESCE(sc.session_revenue, 0) ELSE 0 END) AS homepage_organic_duckduckgo_revenue,

  -- AI Search (Perplexity/OpenAI)
  COUNT(DISTINCT CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source IN ('perplexity', 'openai') THEN sb.unique_session_id END) AS homepage_organic_ai_sessions,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source IN ('perplexity', 'openai') THEN COALESCE(sc.session_purchases, 0) ELSE 0 END) AS homepage_organic_ai_purchases,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source IN ('perplexity', 'openai') THEN COALESCE(sc.session_revenue, 0) ELSE 0 END) AS homepage_organic_ai_revenue,

  -- All Other Long-Tail Organic
  COUNT(DISTINCT CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source NOT IN ('google','bing','yahoo','duckduckgo','perplexity','openai') AND sb.medium = 'organic' THEN sb.unique_session_id END) AS homepage_organic_other_sessions,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source NOT IN ('google','bing','yahoo','duckduckgo','perplexity','openai') AND sb.medium = 'organic' THEN COALESCE(sc.session_purchases, 0) ELSE 0 END) AS homepage_organic_other_purchases,
  SUM(CASE WHEN sb.landing_page_title = 'Home - Dipesh Shah Photography' AND sb.source NOT IN ('google','bing','yahoo','duckduckgo','perplexity','openai') AND sb.medium = 'organic' THEN COALESCE(sc.session_revenue, 0) ELSE 0 END) AS homepage_organic_other_revenue,


  -------------------------------------------------------------------------
  -- ABOUT PAGE DETAILED SEGMENTS
  -------------------------------------------------------------------------
  -- Google Organic
  COUNT(DISTINCT CASE WHEN sb.landing_page_title = 'About - Dipesh Shah Photography' AND sb.source = 'google' AND sb.medium = 'organic' THEN sb.unique_session_id END) AS about_organic_google_sessions,
  SUM(CASE WHEN sb.landing_page_title = 'About - Dipesh Shah Photography' AND sb.source = 'google' AND sb.medium = 'organic' THEN COALESCE(sc.session_purchases, 0) ELSE 0 END) AS about_organic_google_purchases,
  SUM(CASE WHEN sb.landing_page_title = 'About - Dipesh Shah Photography' AND sb.source = 'google' AND sb.medium = 'organic' THEN COALESCE(sc.session_revenue, 0) ELSE 0 END) AS about_organic_google_revenue,

  -- Bing Organic
  COUNT(DISTINCT CASE WHEN sb.landing_page_title = 'About - Dipesh Shah Photography' AND sb.source = 'bing' AND sb.medium = 'organic' THEN sb.unique_session_id END) AS about_organic_bing_sessions,
  SUM(CASE WHEN sb.landing_page_title = 'About - Dipesh Shah Photography' AND sb.source = 'bing' AND sb.medium = 'organic' THEN COALESCE(sc.session_purchases, 0) ELSE 0 END) AS about_organic_bing_purchases,
  SUM(CASE WHEN sb.landing_page_title = 'About - Dipesh Shah Photography' AND sb.source = 'bing' AND sb.medium = 'organic' THEN COALESCE(sc.session_revenue, 0) ELSE 0 END) AS about_organic_bing_revenue,

  -- All Other Organic Combinations for About Page
  COUNT(DISTINCT CASE WHEN sb.landing_page_title = 'About - Dipesh Shah Photography' AND sb.source NOT IN ('google','bing') AND sb.medium = 'organic' THEN sb.unique_session_id END) AS about_organic_other_sessions,
  SUM(CASE WHEN sb.landing_page_title = 'About - Dipesh Shah Photography' AND sb.source NOT IN ('google','bing') AND sb.medium = 'organic' THEN COALESCE(sc.session_purchases, 0) ELSE 0 END) AS about_organic_other_purchases,
  SUM(CASE WHEN sb.landing_page_title = 'About - Dipesh Shah Photography' AND sb.source NOT IN ('google','bing') AND sb.medium = 'organic' THEN COALESCE(sc.session_revenue, 0) ELSE 0 END) AS about_organic_other_revenue

FROM session_attribution sb
LEFT JOIN session_conversions sc ON sb.unique_session_id = sc.unique_session_id
GROUP BY 
  sb.date,
  year,
  month_number,
  month_year,
  week_number,
  week_starting_monday
ORDER BY 
  date DESC;
