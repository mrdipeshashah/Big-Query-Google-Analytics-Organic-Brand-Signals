with attribution as (
  select
      (select value.int_value from unnest(event_params) where key='ga_session_id') as session,
      concat((select value.int_value from unnest(event_params) where key='ga_session_id'),user_pseudo_id) as session_id,
      timestamp_micros(event_timestamp) as timestamp,
      (select value.string_value from unnest(event_params) where key = 'page_location') AS page_location,
      (select value.string_value from unnest(event_params) where key = 'page_title') AS page_title,
      user_pseudo_id as user_id,
      lower(collected_traffic_source.manual_source) as source,
      lower(collected_traffic_source.manual_medium) as medium,
  from `enter.tablename_123456.events_*`
  where event_name='session_start'
)

select
    -- timestamp,
    date(timestamp) as date,
    -- time(timestamp) as time,
    -- format_timestamp('%H:%M:%S',timestamp) as time,
    -- extract(hour from timestamp) as event_hour,
    count(distinct session) as unique_session_count,
    count(distinct user_id) as unique_user_count,
    count(case when page_title='Enter Homepage Page_Title' then session end) as home_page_count,
    count(case when page_title='Enter Homepage Page_Title' and source in ('google','bing') and medium like 'organic%' then session end) as home_page_organic_session_count,

    count(case when page_title='Enter Key Page_Title' then session end) as enterpagename_session_count,
    count(case when page_title='Enter Key Page_Title' and source in ('google','bing') and medium like 'organic%' then session end) as enterpagename_organic_session_count,

    count(case when page_title='Enter Key Page_Title' then session end) as enterpagename_session_count,
    count(case when page_title='Enter Key Page_Title' and source in ('google','bing') and medium like 'organic%' then session end) as enterpagename_organic_session_count,

    count(case when page_title='Enter Key Page_Title' then session end) as enterpagename_page_session_count,
    count(case when page_title='Enter Key Page_Title' and source in ('google','bing') and medium like 'organic%' then session end) as enterpagename_organic_session_count,

from attribution
group by 1
order by 2 desc
-- order by timestamp desc,date,time asc
